{
  "contractVersion": 1,
  "package": {
    "name": "@funsaized/stet",
    "version": "0.0.2",
    "exports": [
      ".",
      "./react",
      "./vue",
      "./svelte",
      "./angular",
      "./style.css",
      "./agent",
      "./agent/capabilities.json",
      "./agent/schemas/*"
    ]
  },
  "frameworks": {
    "vanilla": {
      "extension": "ts",
      "subpath": "",
      "shape": "DOM attachers",
      "lifecycle": "Attach after DOM mount; destroy before removal; destroy and reattach to change options.",
      "import": "@funsaized/stet",
      "symbols": {
        "circle": "circle",
        "underline": "underline",
        "highlight": "highlight",
        "arrow": "arrow",
        "sticky": "sticky",
        "mark": "mark"
      }
    },
    "react": {
      "extension": "tsx",
      "subpath": "/react",
      "shape": "null-rendering components with target refs; Arrow uses from/to refs",
      "lifecycle": "Effects attach after commit and clean up; ref changes require a React commit.",
      "import": "@funsaized/stet/react",
      "symbols": {
        "circle": "Circle",
        "underline": "Underline",
        "highlight": "Highlight",
        "arrow": "Arrow",
        "sticky": "Sticky",
        "mark": "Mark"
      }
    },
    "vue": {
      "extension": "vue",
      "subpath": "/vue",
      "shape": "vStet directives; arrow host is from, binding.to is Element",
      "lifecycle": "mounted/updated/unmounted; mount arrow host only after destination exists.",
      "import": "@funsaized/stet/vue",
      "symbols": {
        "circle": "vStetCircle",
        "underline": "vStetUnderline",
        "highlight": "vStetHighlight",
        "arrow": "vStetArrow",
        "sticky": "vStetSticky",
        "mark": "vStetMark"
      }
    },
    "svelte": {
      "extension": "svelte",
      "subpath": "/svelte",
      "shape": "actions; arrow host is from, options.to is Element",
      "lifecycle": "Action update/destroy; mount arrow host only after destination exists.",
      "import": "@funsaized/stet/svelte",
      "symbols": {
        "circle": "circle",
        "underline": "underline",
        "highlight": "highlight",
        "arrow": "arrow",
        "sticky": "sticky",
        "mark": "mark"
      }
    },
    "angular": {
      "extension": "ts",
      "subpath": "/angular",
      "shape": "standalone Stet*Directive; arrow host is from, input.to is Element",
      "lifecycle": "afterNextRender/ngOnChanges/ngOnDestroy; replace input option objects on update.",
      "import": "@funsaized/stet/angular",
      "symbols": {
        "circle": "StetCircleDirective",
        "underline": "StetUnderlineDirective",
        "highlight": "StetHighlightDirective",
        "arrow": "StetArrowDirective",
        "sticky": "StetStickyDirective",
        "mark": "StetMarkDirective"
      }
    }
  },
  "primitives": {
    "circle": {
      "type": "StetOptions",
      "targets": [
        "target"
      ],
      "padding": 5,
      "purpose": "Emphasize an existing element",
      "meaningfulText": "description",
      "targetType": "Element",
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seed": {
            "type": "number"
          },
          "roughness": {
            "type": "number"
          },
          "boil": {
            "type": "number"
          },
          "stroke": {
            "type": "string"
          },
          "fill": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "resketchOnHover": {
            "type": "boolean"
          },
          "padding": {
            "type": "number"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": []
      },
      "defaults": {
        "seed": "random uint32",
        "roughness": 1,
        "boil": 0,
        "stroke": "CSS token",
        "fill": "CSS token",
        "width": "CSS token",
        "resketchOnHover": false,
        "padding": 5,
        "description": "absent"
      },
      "effects": "fill has no visible effect"
    },
    "underline": {
      "type": "StetOptions",
      "targets": [
        "target"
      ],
      "padding": 3,
      "purpose": "Emphasize words, following wrapped text",
      "meaningfulText": "description",
      "targetType": "Element",
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seed": {
            "type": "number"
          },
          "roughness": {
            "type": "number"
          },
          "boil": {
            "type": "number"
          },
          "stroke": {
            "type": "string"
          },
          "fill": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "resketchOnHover": {
            "type": "boolean"
          },
          "padding": {
            "type": "number"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": []
      },
      "defaults": {
        "seed": "random uint32",
        "roughness": 1,
        "boil": 0,
        "stroke": "CSS token",
        "fill": "CSS token",
        "width": "CSS token",
        "resketchOnHover": false,
        "padding": 3,
        "description": "absent"
      },
      "effects": "fill has no visible effect"
    },
    "highlight": {
      "type": "StetOptions",
      "targets": [
        "target"
      ],
      "padding": 5,
      "purpose": "Marker wash following wrapped text",
      "meaningfulText": "description",
      "targetType": "Element",
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seed": {
            "type": "number"
          },
          "roughness": {
            "type": "number"
          },
          "boil": {
            "type": "number"
          },
          "stroke": {
            "type": "string"
          },
          "fill": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "resketchOnHover": {
            "type": "boolean"
          },
          "padding": {
            "type": "number"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": []
      },
      "defaults": {
        "seed": "random uint32",
        "roughness": 1,
        "boil": 0,
        "stroke": "CSS token",
        "fill": "CSS token",
        "width": "CSS token",
        "resketchOnHover": false,
        "padding": 5,
        "description": "absent"
      },
      "effects": "fill controls wash; stroke/width have no visible effect; padding positions the overlay"
    },
    "arrow": {
      "type": "ArrowOptions",
      "targets": [
        "from",
        "to"
      ],
      "purpose": "Connect two existing elements",
      "meaningfulText": "label or description; describes to",
      "targetType": "Element",
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "curvature": {
            "type": "number"
          },
          "seed": {
            "type": "number"
          },
          "roughness": {
            "type": "number"
          },
          "boil": {
            "type": "number"
          },
          "stroke": {
            "type": "string"
          },
          "fill": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "resketchOnHover": {
            "type": "boolean"
          },
          "padding": {
            "type": "number"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": []
      },
      "defaults": {
        "label": "absent",
        "curvature": 0.16,
        "seed": "random uint32",
        "roughness": 1,
        "boil": 0,
        "stroke": "CSS token",
        "fill": "CSS token",
        "width": "CSS token",
        "resketchOnHover": false,
        "description": "absent"
      },
      "effects": "fill/padding have no visible effect; curvature is clamped to -0.8…0.8"
    },
    "sticky": {
      "type": "StickyOptions",
      "targets": [
        "target"
      ],
      "padding": 14,
      "purpose": "Explain with concise paper-note text",
      "meaningfulText": "text; describes target",
      "targetType": "Element",
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "side": {
            "type": "string",
            "enum": [
              "auto",
              "top",
              "right",
              "bottom",
              "left"
            ]
          },
          "seed": {
            "type": "number"
          },
          "roughness": {
            "type": "number"
          },
          "boil": {
            "type": "number"
          },
          "stroke": {
            "type": "string"
          },
          "fill": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "resketchOnHover": {
            "type": "boolean"
          },
          "padding": {
            "type": "number"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "text"
        ]
      },
      "defaults": {
        "side": "auto",
        "seed": "random uint32",
        "roughness": 1,
        "boil": 0,
        "stroke": "CSS token",
        "fill": "CSS token",
        "width": "CSS token",
        "resketchOnHover": false,
        "padding": 14,
        "description": "absent"
      },
      "effects": "fill controls paper; stroke controls text; width has no visible effect"
    },
    "mark": {
      "type": "StetOptions",
      "targets": [
        "target"
      ],
      "padding": 4,
      "purpose": "Check right or cross wrong; kind is a separate core argument",
      "meaningfulText": "description",
      "targetType": "Element",
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seed": {
            "type": "number"
          },
          "roughness": {
            "type": "number"
          },
          "boil": {
            "type": "number"
          },
          "stroke": {
            "type": "string"
          },
          "fill": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "resketchOnHover": {
            "type": "boolean"
          },
          "padding": {
            "type": "number"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": []
      },
      "defaults": {
        "seed": "random uint32",
        "roughness": 1,
        "boil": 0,
        "stroke": "CSS token",
        "fill": "CSS token",
        "width": "CSS token",
        "resketchOnHover": false,
        "padding": 4,
        "description": "absent"
      },
      "kind": {
        "type": "string",
        "enum": [
          "right",
          "wrong"
        ]
      },
      "effects": "fill has no visible effect"
    }
  },
  "targetPreference": [
    "ref",
    "id",
    "data-attribute",
    "source",
    "stet-attribute",
    "css"
  ],
  "constraints": {
    "ownership": "Existing UI owns layout, semantics, focus, pointer interaction, forms and lifecycle. Annotations never replace controls.",
    "accessibility": "SVG is decorative. Supply description for meaningful marks. Sticky text and arrow labels are DOM text linked by aria-describedby. Do not use annotations as the only persistent safety warning.",
    "motion": "Still by default; reduced motion disables boil and hover resketch live. Fixed seed, dimensions and options reproduce geometry.",
    "lifecycle": "DOM Elements in the current document and document.body must exist. Options are snapshots. Handles expose refresh(), resketch(seed?), destroy().",
    "targeting": "Targets are source-editing evidence, not executable selectors. Prove uniqueness and readiness in application code. Arrow order is from, to.",
    "placement": "Body overlays; resize/scroll/font tracking. Movement without resize needs refresh(). No collision engine, cross-document targets, top-layer dialogs or transformed/zoomed body/html support. Partial clipping and very long notes need visual review.",
    "styling": "Import @funsaized/stet/style.css once; preserve target layout and semantics. CSS variables theme the overlay."
  },
  "tools": {
    "claude": ".claude/skills",
    "cursor": ".agents/skills",
    "opencode": ".agents/skills",
    "codex": ".agents/skills"
  },
  "cli": {
    "node": ">=20",
    "commands": [
      "inspect [--project <directory>]",
      "schema annotation-plan|capabilities",
      "validate <file>",
      "snippet <primitive> --framework <framework>",
      "snippet --pattern lifecycle --framework <framework>",
      "agent init|update --tool <tool>",
      "--help",
      "--version"
    ],
    "exitCodes": {
      "success": 0,
      "invalidPlan": 1,
      "usage": 2,
      "io": 3,
      "conflict": 4
    }
  }
}
