{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@funsaized/stet": ["../src/index.ts"],
      "@funsaized/stet/react": ["../src/react.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
